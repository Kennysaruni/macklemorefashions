generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String    @default("Macklemore Executive")
  passwordHash String
  role         String    @default("SUPER_ADMIN")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Brand {
  id                 String       @id
  slug               String       @unique
  name               String
  tagline            String
  bio                String
  story              String
  originCity         String
  originCountry      String
  creativeDirector   String
  foundedYear        Int          @default(2021)
  isProprietary      Boolean      @default(false)
  lookbookBannerUrl  String
  secondaryBannerUrl String
  commissionRatePct  Float        @default(20.0)
  allocatedRegions   String[]
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  collections        Collection[]
  products           Product[]
}

model Collection {
  id           String   @id
  slug         String   @unique
  title        String
  seasonCode   String
  manifesto    String
  heroImageUrl String
  releaseDate  String
  isDropLive   Boolean  @default(true)
  isVipLocked  Boolean  @default(false)
  brandId      String
  brandName    String
  brand        Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id                String           @id
  slug              String           @unique
  skuPrefix         String
  title             String
  subtitle          String
  description       String
  gender            String
  category          String
  fabricWeightGsm   Int              @default(360)
  fabricComposition String
  originLabel       String
  basePriceCad      Float
  priceRangeLabel   String?
  editorialImageUrl String
  flatlayImageUrl   String
  s3EditorialKey    String?
  s3FlatlayKey      String?
  colorName         String
  colorHex          String           @default("#7A491D")
  isFeatured        Boolean          @default(false)
  isActive          Boolean          @default(true)
  brandId           String
  brandSlug         String
  brandName         String
  collectionSlug    String
  brand             Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  variants          ProductVariant[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model ProductVariant {
  id          String  @id @default(cuid())
  productId   String
  size        String
  sku         String  @unique
  hubALagos   Int     @default(5)
  hubBToronto Int     @default(4)
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id                 String      @id
  orderNumber        String      @unique
  customerName       String
  customerEmail      String
  customerPhone      String
  destinationCountry String
  destinationCity    String
  shippingAddress    String?
  currency           String
  subtotalAmount     Float
  shippingAmount     Float
  dutiesAmount       Float
  totalAmount        Float
  totalAmountCad     Float       @default(0)
  assignedHub        String
  courierPartner     String
  waybillNumber      String?
  status             String      @default("PENDING_PAYMENT")
  paymentProvider    String
  paymentReference   String      @unique
  paymentStatus      String      @default("INITIATED")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  items              OrderItem[]
}

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  productId    String
  productTitle String
  brandName    String
  size         String
  quantity     Int
  unitPrice    Float
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model B2BInquiry {
  id                  String   @id
  referenceCode       String   @unique
  channel             String
  brandOrCompanyName  String
  contactName         String
  contactRole         String
  email               String
  phone               String
  headquartersCountry String
  websiteUrl          String
  targetRegions       String[]
  annualVolumeTier    String
  message             String
  status              String   @default("NEW")
  assignedExecutive   String   @default("Micah Elechi")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
