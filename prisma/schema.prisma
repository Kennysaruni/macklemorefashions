// Macklemore Fashion (macklemorefashions.com) — Enterprise Prisma Database Schema
// Headquarters: Toronto, Canada & Victoria Island, Lagos, Nigeria
// Hubs: Hub A (Lagos, West Africa) | Hub B (Toronto, North America / Global) | Regional Node (Nairobi, East Africa)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  BRAND_MANAGER
  CUSTOMER
}

enum CurrencyCode {
  CAD
  USD
  GBP
  EUR
  NGN
  GHS
  KES
}

enum GenderTarget {
  MEN
  WOMEN
  UNISEX
}

enum HubCode {
  HUB_A_LAGOS
  HUB_B_TORONTO
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  ALLOCATED_TO_HUB
  DISPATCHED
  IN_CUSTOMS
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  PAYSTACK
  MPESA_DARAJA
}

enum PaymentStatus {
  INITIATED
  STK_PUSH_SENT
  PROCESSING
  SUCCEEDED
  FAILED
  RECONCILED_MANUALLY
}

enum B2BLeadStatus {
  NEW
  IN_REVIEW
  MEETING_SCHEDULED
  PARTNERED
  ARCHIVED
}

enum InquiryChannel {
  CONCIERGE
  WHOLESALE
  BRAND_REPRESENTATION
  PRESS
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  phone         String?
  passwordHash  String?
  role          Role         @default(CUSTOMER)
  preferredCurr CurrencyCode @default(CAD)
  managedBrands Brand[]      @relation("BrandManagers")
  orders        Order[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([role])
}

model Brand {
  id                 String       @id @default(cuid())
  slug               String       @unique
  name               String
  tagline            String?
  bio                String       @db.Text
  story              String       @db.Text
  originCity         String       // e.g., "LAGOS", "TORONTO", "MILAN", "NAIROBI", "ACCRA"
  originCountry      String
  creativeDirector   String?
  foundedYear        Int          @default(2021)
  isProprietary      Boolean      @default(false) // true for Macklemore Fashion proprietary label
  lookbookBannerUrl  String
  secondaryBannerUrl String?
  logoSvg            String?      @db.Text
  commissionRatePct  Decimal      @default(25.00) @db.Decimal(5, 2)
  allocatedRegions   String[]     // ["WEST_AFRICA", "EAST_AFRICA", "NORTH_AMERICA", "EUROPE", "UK"]
  isActive           Boolean      @default(true)
  managers           User[]       @relation("BrandManagers")
  collections        Collection[]
  products           Product[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([slug, isActive])
}

model Collection {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  seasonCode   String    // e.g., "[ DROP 04 // HARMATTAN & FROST ]"
  manifesto    String    @db.Text
  heroImageUrl String
  heroVideoUrl String?
  releaseDate  DateTime
  isDropLive   Boolean   @default(false)
  isVipLocked  Boolean   @default(false)
  brandId      String
  brand        Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([brandId, isDropLive])
}

model Product {
  id                String           @id @default(cuid())
  slug              String           @unique
  skuPrefix         String           @unique
  title             String
  subtitle          String?
  description       String           @db.Text
  gender            GenderTarget     @default(UNISEX)
  category          String           // "OUTERWEAR", "SHIRTING", "TROUSERS", "KAFTAN_ARCHIVE", "KNITWEAR", "ACCESSORIES"
  fabricWeightGsm   Int?             // e.g., 480
  fabricComposition String           // e.g., "100% NIGERIAN ADIRE INDIGO COTTON // 480 GSM"
  originLabel       String           // e.g., "LAGOS / TORONTO"
  careInstructions  String?
  basePriceCad      Decimal          @db.Decimal(10, 2)
  priceMatrixJson   Json             // Explicit price overrides per CurrencyCode: { CAD, USD, GBP, EUR, NGN, GHS, KES }
  editorialImageUrl String           // Primary runway/lookbook shot
  flatlayImageUrl   String           // Secondary garment flat-lay detail shot for 700ms hover crossfade
  galleryUrls       String[]
  isFeatured        Boolean          @default(false)
  isArchived        Boolean          @default(false)
  brandId           String
  brand             Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  collectionId      String?
  collection        Collection?      @relation(fields: [collectionId], references: [id])
  variants          ProductVariant[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([brandId, category, gender])
}

model ProductVariant {
  id          String      @id @default(cuid())
  sku         String      @unique
  size        String      // "XS", "S", "M", "L", "XL", "XXL", "OS"
  colorName   String
  colorHex    String
  weightGrams Int         @default(650)
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  hubStocks   HubStock[]
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([productId, size])
}

model InventoryHub {
  id            String     @id @default(cuid())
  code          HubCode    @unique
  name          String     // "Hub A: Lagos Victoria Island Fulfillment Center" | "Hub B: Toronto International Hub"
  city          String
  country       String
  coordinates   String     // e.g., "06°25'41\"N 03°25'19\"E"
  address       String
  servedRegions String[]   // ISO country codes and continental corridors
  stocks        HubStock[]
  orders        Order[]
}

model HubStock {
  id                String         @id @default(cuid())
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  hubId             String
  hub               InventoryHub   @relation(fields: [hubId], references: [id], onDelete: Cascade)
  quantityOnHand    Int            @default(0)
  reservedQuantity  Int            @default(0)
  lowStockThreshold Int            @default(5)
  updatedAt         DateTime       @updatedAt

  @@unique([variantId, hubId])
}

model Order {
  id                  String               @id @default(cuid())
  orderNumber         String               @unique // e.g., "MKM-2026-8841"
  userId              String?
  user                User?                @relation(fields: [userId], references: [id])
  customerEmail       String
  customerName        String
  customerPhone       String
  shippingAddressJson Json
  destinationCountry  String               // ISO-2 e.g., "NG", "GH", "KE", "CA", "GB", "US", "FR"
  currency            CurrencyCode
  exchangeRateUsed    Decimal              @db.Decimal(14, 6)
  subtotalAmount      Decimal              @db.Decimal(12, 2)
  shippingAmount      Decimal              @db.Decimal(12, 2)
  dutiesAmount        Decimal              @db.Decimal(12, 2)
  totalAmount         Decimal              @db.Decimal(12, 2)
  assignedHubId       String
  assignedHub         InventoryHub         @relation(fields: [assignedHubId], references: [id])
  courierPartner      String               // "GIG Logistics", "Wells Fargo Courier Kenya", "DHL Express International"
  waybillNumber       String?
  status              OrderStatus          @default(PENDING_PAYMENT)
  items               OrderItem[]
  transactions        PaymentTransaction[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status, destinationCountry])
}

model OrderItem {
  id               String         @id @default(cuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  productTitle     String
  brandName        String
  size             String
  colorName        String
  quantity         Int
  unitPrice        Decimal        @db.Decimal(12, 2)
  fulfilledFromHub HubCode
}

model PaymentTransaction {
  id                  String          @id @default(cuid())
  orderId             String
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider            PaymentProvider
  providerReference   String          @unique // Stripe PaymentIntent ID, Paystack Reference, or M-Pesa CheckoutRequestID
  mpesaReceiptNumber  String?         // e.g., "QKH8921L0P"
  phoneNumber         String?         // Used for M-Pesa Daraja 2.0 STK Push
  currency            CurrencyCode
  amount              Decimal         @db.Decimal(12, 2)
  status              PaymentStatus   @default(INITIATED)
  rawWebhookPayload   Json?
  reconciledByAdminId String?
  reconciledAt        DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([provider, status])
}

model B2BInquiry {
  id                  String         @id @default(cuid())
  referenceCode       String         @unique // e.g., "B2B-MKM-0192"
  channel             InquiryChannel @default(BRAND_REPRESENTATION)
  brandOrCompanyName  String
  contactName         String
  contactRole         String
  email               String
  phone               String
  headquartersCountry String
  websiteUrl          String?
  lookbookDeckUrl     String?
  targetRegions       String[]       // ["WEST_AFRICA", "EAST_AFRICA", "PAN_AFRICAN", "NORTH_AMERICA", "EUROPE"]
  annualVolumeTier    String         // "< $250K", "$250K - $1M", "$1M - $5M", "$5M+"
  message             String         @db.Text
  status              B2BLeadStatus  @default(NEW)
  internalNotes       String?        @db.Text
  assignedExecutive   String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([status, channel])
}

model VipDropSubscriber {
  id         String   @id @default(cuid())
  email      String?  @unique
  phone      String?  @unique
  region     String
  accessCode String?
  createdAt  DateTime @default(now())
}

model SiteConfig {
  id                   String   @id @default("singleton")
  vipTribalTeaserMode  Boolean  @default(false)
  activeDropTitle      String   @default("DROP 04 // HARMATTAN & FROST")
  activeDropTargetDate DateTime
  teaserHeadline       String   @default("WE ARE WEAVING SOMETHING MONUMENTAL")
  fxRatesJson          Json
  updatedAt            DateTime @updatedAt
}

